<!-- Breadcrumb -->
<nav class="mb-6 animate-fade-in">
    <ol class="flex items-center gap-2 text-sm text-slate-400">
        <li><a href="/courses" class="hover:text-white transition-colors">Dashboard</a></li>
        <li><svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg></li>
        <li class="text-white font-medium">Export (Legacy)</li>
    </ol>
</nav>

<div class="mb-8 animate-fade-in">
    <h1 class="text-2xl font-bold text-white">CSV Export (Legacy)</h1>
    <p class="mt-1 text-slate-400">Export course data from Google Sheets to Moodle-compatible CSV.</p>
</div>

<div class="animate-fade-in stagger-1">
    <form method="post" action="/export" class="bg-slate-900 border border-slate-800 rounded-xl p-6">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div>
                <label for="spreadsheet_id" class="block text-sm font-medium text-slate-300 mb-1.5">Spreadsheet ID</label>
                <input type="text" name="spreadsheet_id" id="spreadsheet_id"
                       value="1sHTk0kr4m0beo7df4wiM6ZCjOBfhOnaQLIMGJTePcv0"
                       class="w-full px-4 py-2.5 bg-slate-800 border border-slate-700 rounded-lg text-white text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent">
            </div>
            <div>
                <label for="range" class="block text-sm font-medium text-slate-300 mb-1.5">Range</label>
                <input type="text" name="range" id="range"
                       class="w-full px-4 py-2.5 bg-slate-800 border border-slate-700 rounded-lg text-white text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent">
            </div>
            <div>
                <label for="cat_id" class="block text-sm font-medium text-slate-300 mb-1.5">Category ID</label>
                <select name="cat_id" id="cat_id"
                        class="w-full px-4 py-2.5 bg-slate-800 border border-slate-700 rounded-lg text-white text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent">
                    <option selected disabled>Select a category...</option>
                    {{#each categories}}
                        <option value="{{this.cat_id}}">{{this.program_studi}} — {{this.cat_id}}</option>
                    {{/each}}
                </select>
            </div>
            <div>
                <label for="start_date" class="block text-sm font-medium text-slate-300 mb-1.5">Start Date</label>
                <input type="date" name="start_date" id="start_date" value="2026-02-09"
                       class="w-full px-4 py-2.5 bg-slate-800 border border-slate-700 rounded-lg text-white text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent">
            </div>
            <div>
                <label for="end_date" class="block text-sm font-medium text-slate-300 mb-1.5">End Date</label>
                <input type="date" name="end_date" id="end_date" value="2036-02-09"
                       class="w-full px-4 py-2.5 bg-slate-800 border border-slate-700 rounded-lg text-white text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent">
            </div>
        </div>

        <div class="mt-6 flex flex-wrap items-center gap-3">
            <button type="submit" class="px-4 py-2.5 rounded-lg bg-indigo-600 text-white text-sm font-medium hover:bg-indigo-500 transition-colors cursor-pointer">Get CSV</button>
            <button type="submit" formaction="/export/dryrun" class="px-4 py-2.5 rounded-lg bg-slate-700 text-white text-sm font-medium hover:bg-slate-600 transition-colors cursor-pointer">Dry Run</button>
            <button type="submit" formaction="/export/run" class="px-4 py-2.5 rounded-lg bg-emerald-600 text-white text-sm font-medium hover:bg-emerald-500 transition-colors cursor-pointer">Submit!</button>
            <a href="/export/createcat" class="px-4 py-2.5 rounded-lg bg-red-500/10 text-red-400 text-sm font-medium border border-red-500/20 hover:bg-red-500/20 transition-colors">Create Academic Year Categories</a>
        </div>
    </form>
</div>
