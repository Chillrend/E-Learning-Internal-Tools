<!-- Page Header -->
<div class="mb-8 animate-fade-in">
    <div class="flex items-center gap-3 mb-2">
        <a href="/courses" class="text-slate-500 hover:text-slate-300 transition-colors">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
            </svg>
        </a>
        <h1 class="text-3xl font-bold text-white">Connection Diagnostics</h1>
    </div>
    <p class="mt-2 text-slate-400">Test connectivity to all external services before deploying courses.</p>
</div>

<!-- Terminal Window -->
<div class="animate-fade-in stagger-1">
    <div class="rounded-xl border border-slate-700/50 overflow-hidden shadow-2xl shadow-black/30">
        <!-- Terminal Title Bar -->
        <div class="flex items-center justify-between px-4 py-3 bg-slate-800/80 border-b border-slate-700/50">
            <div class="flex items-center gap-2">
                <span class="w-3 h-3 rounded-full bg-red-500/80"></span>
                <span class="w-3 h-3 rounded-full bg-yellow-500/80"></span>
                <span class="w-3 h-3 rounded-full bg-green-500/80"></span>
                <span class="ml-3 text-xs text-slate-400 font-mono">elearning-tools — diagnostics</span>
            </div>
            <button
                id="btn-run"
                onclick="runDiagnostics()"
                class="inline-flex items-center gap-2 px-4 py-1.5 rounded-lg bg-indigo-600 hover:bg-indigo-500 text-white text-xs font-semibold transition-all hover:shadow-lg hover:shadow-indigo-500/20 active:scale-95 disabled:opacity-40 disabled:cursor-not-allowed disabled:hover:bg-indigo-600 disabled:hover:shadow-none disabled:active:scale-100"
            >
                <svg id="btn-icon-play" class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z" />
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
                <svg id="btn-icon-spin" class="w-3.5 h-3.5 animate-spin hidden" fill="none" viewBox="0 0 24 24">
                    <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                    <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path>
                </svg>
                <span id="btn-text">Run Diagnostics</span>
            </button>
        </div>

        <!-- Terminal Body -->
        <div id="terminal" class="bg-slate-950 px-5 py-5 font-mono text-sm leading-relaxed min-h-[280px] max-h-[500px] overflow-y-auto">
            <div id="terminal-welcome" class="text-slate-500">
                <p>$ <span class="text-slate-400">Ready to test connections.</span></p>
                <p>$ <span class="text-slate-400">Click <span class="text-indigo-400 font-semibold">"Run Diagnostics"</span> to begin...</span></p>
                <p class="mt-2">&nbsp;</p>
            </div>
            <div id="terminal-output"></div>
        </div>
    </div>
</div>

<!-- Info Cards -->
<div class="mt-8 grid grid-cols-1 md:grid-cols-3 gap-4 animate-fade-in stagger-2">
    <div class="bg-slate-900 border border-slate-800 rounded-xl p-5">
        <div class="flex items-center gap-3 mb-2">
            <div class="w-8 h-8 rounded-lg bg-emerald-500/10 border border-emerald-500/20 flex items-center justify-center">
                <svg class="w-4 h-4 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 7v10c0 2.21 3.582 4 8 4s8-1.79 8-4V7M4 7c0 2.21 3.582 4 8 4s8-1.79 8-4M4 7c0-2.21 3.582-4 8-4s8 1.79 8 4" />
                </svg>
            </div>
            <h3 class="text-sm font-semibold text-white">Local SQLite</h3>
        </div>
        <p class="text-xs text-slate-500 leading-relaxed">Tests the internal SQLite database used for staging courses and tracking deployments.</p>
    </div>
    <div class="bg-slate-900 border border-slate-800 rounded-xl p-5">
        <div class="flex items-center gap-3 mb-2">
            <div class="w-8 h-8 rounded-lg bg-blue-500/10 border border-blue-500/20 flex items-center justify-center">
                <svg class="w-4 h-4 text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 12h14M5 12a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v4a2 2 0 01-2 2M5 12a2 2 0 00-2 2v4a2 2 0 002 2h14a2 2 0 002-2v-4a2 2 0 00-2-2" />
                </svg>
            </div>
            <h3 class="text-sm font-semibold text-white">Moodle MySQL</h3>
        </div>
        <p class="text-xs text-slate-500 leading-relaxed">Connects to the Moodle MySQL server to verify database credentials and network access.</p>
    </div>
    <div class="bg-slate-900 border border-slate-800 rounded-xl p-5">
        <div class="flex items-center gap-3 mb-2">
            <div class="w-8 h-8 rounded-lg bg-amber-500/10 border border-amber-500/20 flex items-center justify-center">
                <svg class="w-4 h-4 text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
                </svg>
            </div>
            <h3 class="text-sm font-semibold text-white">Moodle REST API</h3>
        </div>
        <p class="text-xs text-slate-500 leading-relaxed">Calls the Moodle Web Services API to verify the token and endpoint are working.</p>
    </div>
</div>

<style>
    @keyframes blink {
        0%, 100% { opacity: 1; }
        50% { opacity: 0; }
    }
    .cursor-blink::after {
        content: '▌';
        animation: blink 1s step-end infinite;
        color: #818cf8;
    }
    @keyframes typeIn {
        from { opacity: 0; transform: translateX(-4px); }
        to { opacity: 1; transform: translateX(0); }
    }
    .line-animate {
        animation: typeIn 0.25s ease-out forwards;
    }
    #terminal::-webkit-scrollbar { width: 6px; }
    #terminal::-webkit-scrollbar-track { background: transparent; }
    #terminal::-webkit-scrollbar-thumb { background: #334155; border-radius: 3px; }
    #terminal::-webkit-scrollbar-thumb:hover { background: #475569; }
</style>

<script>
function runDiagnostics() {
    const btn = document.getElementById('btn-run');
    const btnText = document.getElementById('btn-text');
    const iconPlay = document.getElementById('btn-icon-play');
    const iconSpin = document.getElementById('btn-icon-spin');
    const output = document.getElementById('terminal-output');
    const welcome = document.getElementById('terminal-welcome');
    const terminal = document.getElementById('terminal');

    // Disable button
    btn.disabled = true;
    btnText.textContent = 'Running...';
    iconPlay.classList.add('hidden');
    iconSpin.classList.remove('hidden');

    // Clear previous output
    output.innerHTML = '';
    welcome.classList.add('hidden');

    // Add start banner
    appendLine('─'.repeat(56), 'text-slate-700');
    appendLine('  E-Learning Tools — Connection Diagnostics', 'text-slate-300 font-semibold');
    appendLine('  ' + new Date().toLocaleString(), 'text-slate-600');
    appendLine('─'.repeat(56), 'text-slate-700');
    appendLine('', '');

    const source = new EventSource('/health/test');

    source.onmessage = function(event) {
        const data = JSON.parse(event.data);

        if (data.type === 'start') {
            appendLine(
                `[${data.step}/${data.total}] Testing ${data.label} ...`,
                'text-slate-400 cursor-blink'
            );
        }

        if (data.type === 'result') {
            // Remove the blink cursor from the last line
            const lines = output.querySelectorAll('p');
            const lastLine = lines[lines.length - 1];
            if (lastLine) {
                lastLine.classList.remove('cursor-blink');
                const latency = `(${data.latencyMs}ms)`;
                if (data.status === 'ok') {
                    lastLine.innerHTML =
                        `<span class="text-slate-500">[${data.step}/${data.total}]</span> ` +
                        `<span class="text-slate-300">${data.label}</span>` +
                        `<span class="text-emerald-400 ml-3">✔ OK</span> ` +
                        `<span class="text-slate-600">${latency}</span>`;

                    // Detail sub-line
                    appendLine(`     └─ ${data.message}`, 'text-slate-600 text-xs ml-4');
                } else {
                    lastLine.innerHTML =
                        `<span class="text-slate-500">[${data.step}/${data.total}]</span> ` +
                        `<span class="text-slate-300">${data.label}</span>` +
                        `<span class="text-red-400 ml-3">✗ FAIL</span> ` +
                        `<span class="text-slate-600">${latency}</span>`;

                    appendLine(`     └─ ${data.message}`, 'text-red-400/70 text-xs ml-4');
                }
            }
        }

        if (data.type === 'done') {
            source.close();
            appendLine('', '');
            appendLine('─'.repeat(56), 'text-slate-700');

            if (data.passed === data.total) {
                appendLine(
                    `  ✔ All ${data.total} checks passed`,
                    'text-emerald-400 font-semibold'
                );
            } else {
                const failed = data.total - data.passed;
                appendLine(
                    `  ✗ ${failed} of ${data.total} check${failed > 1 ? 's' : ''} failed`,
                    'text-red-400 font-semibold'
                );
            }

            appendLine('─'.repeat(56), 'text-slate-700');

            // Re-enable button
            btn.disabled = false;
            btnText.textContent = 'Run Again';
            iconPlay.classList.remove('hidden');
            iconSpin.classList.add('hidden');
        }
    };

    source.onerror = function() {
        source.close();
        appendLine('', '');
        appendLine('  ⚠ Connection to server lost', 'text-amber-400');

        btn.disabled = false;
        btnText.textContent = 'Retry';
        iconPlay.classList.remove('hidden');
        iconSpin.classList.add('hidden');
    };

    function appendLine(text, classes) {
        const p = document.createElement('p');
        p.className = `${classes} line-animate`;
        p.innerHTML = text || '&nbsp;';
        output.appendChild(p);
        terminal.scrollTop = terminal.scrollHeight;
    }
}
</script>
