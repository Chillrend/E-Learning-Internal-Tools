<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="E-Learning Internal Tools — Course management and deployment for Moodle">
    <title>{{title}} — E-Learning Tools</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <style type="text/tailwindcss">
        @theme {
            --font-sans: 'Inter', system-ui, sans-serif;
            --color-brand-50: #eef2ff;
            --color-brand-100: #e0e7ff;
            --color-brand-200: #c7d2fe;
            --color-brand-300: #a5b4fc;
            --color-brand-400: #818cf8;
            --color-brand-500: #6366f1;
            --color-brand-600: #4f46e5;
            --color-brand-700: #4338ca;
        }
    </style>
    <style>
        /* Smooth transitions for interactive elements */
        .card-hover {
            transition: transform 0.2s ease, box-shadow 0.2s ease;
        }
        .card-hover:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 25px -5px rgba(0, 0, 0, 0.3);
        }

        /* Subtle fade-in animation */
        @keyframes fadeInUp {
            from { opacity: 0; transform: translateY(10px); }
            to { opacity: 1; transform: translateY(0); }
        }
        .animate-fade-in {
            animation: fadeInUp 0.4s ease-out forwards;
        }

        /* Staggered animation delays */
        .stagger-1 { animation-delay: 0.05s; }
        .stagger-2 { animation-delay: 0.1s; }
        .stagger-3 { animation-delay: 0.15s; }
        .stagger-4 { animation-delay: 0.2s; }

        /* Accordion toggle */
        .accordion-content {
            max-height: 0;
            overflow: hidden;
            transition: max-height 0.3s ease-out;
        }
        .accordion-content.open {
            max-height: 2000px;
        }
    </style>
</head>
<body class="bg-slate-950 text-slate-200 font-sans min-h-screen">
    {{> navbar}}

    <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
        {{{body}}}
    </main>

    <footer class="border-t border-slate-800 mt-16">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6">
            <p class="text-center text-xs text-slate-600">
                E-Learning Tools v2.0 &mdash; &copy; 2023-2026 Chillrend &mdash; UPATIK PNJ &mdash;
                <a href="https://github.com/Chillrend/E-Learning-Internal-Tools" class="text-indigo-400/60 hover:text-indigo-400 transition-colors">Open Source</a>
            </p>
        </div>
    </footer>

    {{#each scripts}}
        <script src="{{this}}"></script>
    {{/each}}
</body>
</html>