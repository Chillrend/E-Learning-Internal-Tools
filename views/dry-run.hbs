<!-- Breadcrumb -->
<nav class="mb-6">
    <ol class="flex items-center gap-2 text-sm text-slate-400">
        <li><a href="/courses" class="hover:text-white transition-colors">Dashboard</a></li>
        <li><svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg></li>
        <li><a href="/export" class="hover:text-white transition-colors">Export</a></li>
        <li><svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg></li>
        <li class="text-white font-medium">Dry Run</li>
    </ol>
</nav>

<div class="mb-6">
    <h1 class="text-2xl font-bold text-white mb-2">Dry Run Preview</h1>
    <div class="space-y-1 text-sm text-slate-400">
        <p>Category: <span class="text-white">{{category}}</span></p>
        <p>Enrolment Start Date: <span class="text-white">{{enrolmentStartDate}}</span></p>
        <p>Enrolment End Date: <span class="text-white">{{enrolmentEndDate}}</span></p>
        <p>Course start date will be the same as <span class="font-medium text-indigo-300">Enrolment Start Date</span></p>
    </div>
    <p class="mt-2 text-sm text-slate-500">Please double-check category by clicking this
        <a target="_blank" href="{{MOODLE_BASE_URL}}/course/index.php?categoryid={{category_id}}" class="text-indigo-400 hover:text-indigo-300 transition-colors">link</a>
    </p>
</div>

<div class="bg-slate-900 border border-slate-800 rounded-xl overflow-hidden">
    <div class="overflow-x-auto">
        <table class="w-full">
            <thead>
                <tr class="text-left text-xs font-medium text-slate-400 uppercase tracking-wider">
                    <th class="px-6 py-3 border-b border-slate-800">No.</th>
                    <th class="px-6 py-3 border-b border-slate-800">Course Name</th>
                    <th class="px-6 py-3 border-b border-slate-800">Enrolment Key Dosen</th>
                    <th class="px-6 py-3 border-b border-slate-800">Enrolment Key Mahasiswa</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-slate-800/50">
                {{#each rows}}
                <tr class="hover:bg-slate-800/30 transition-colors">
                    <td class="px-6 py-3 text-sm text-slate-500">{{@index}}</td>
                    <td class="px-6 py-3 text-sm font-medium text-white">{{this.[0]}}</td>
                    <td class="px-6 py-3 text-sm font-mono text-amber-300/80">{{this.[1]}}</td>
                    <td class="px-6 py-3 text-sm font-mono text-cyan-300/80">{{this.[2]}}</td>
                </tr>
                {{/each}}
            </tbody>
        </table>
    </div>
</div>