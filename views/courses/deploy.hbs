<!-- Breadcrumb -->
<nav class="mb-6 animate-fade-in">
    <ol class="flex items-center gap-2 text-sm text-slate-400">
        <li><a href="/courses" class="hover:text-white transition-colors">Dashboard</a></li>
        <li><svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg></li>
        <li><a href="/courses/{{category.id}}" class="hover:text-white transition-colors">{{category.program_studi}}</a></li>
        <li><svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg></li>
        <li class="text-white font-medium">Deploy</li>
    </ol>
</nav>

<!-- Header -->
<div class="mb-8 animate-fade-in stagger-1">
    <div class="flex items-start gap-4">
        <div class="w-12 h-12 rounded-xl bg-emerald-500/10 border border-emerald-500/20 flex items-center justify-center flex-shrink-0">
            <svg class="w-6 h-6 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12" />
            </svg>
        </div>
        <div>
            <h1 class="text-2xl font-bold text-white">Deploy to Moodle</h1>
            <p class="mt-1 text-slate-400">
                Deploying <span class="text-emerald-300 font-medium">{{courseCount}} course(s)</span> to
                <span class="text-indigo-300">{{category.program_studi}}</span>
            </p>
            {{#unless category.academic_year_cat_id}}
            <div class="mt-3 flex items-center gap-2 px-3 py-2 rounded-lg bg-amber-500/10 border border-amber-500/20">
                <svg class="w-4 h-4 text-amber-400 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5L13.732 4c-.77-.833-1.964-.833-2.732 0L4.082 16.5c-.77.833.192 2.5 1.732 2.5z" />
                </svg>
                <span class="text-sm text-amber-300">No semester category ID set. Courses will be created under the parent category.</span>
            </div>
            {{/unless}}
        </div>
    </div>
</div>

<!-- Deploy Form -->
<form method="POST" action="/courses/{{category.id}}/deploy" id="deployForm">
    <input type="hidden" name="ids" value="{{selectedIds}}">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-8 animate-fade-in stagger-2">
        <div class="bg-slate-900 border border-slate-800 rounded-xl p-5">
            <label for="start_date" class="block text-sm font-medium text-slate-300 mb-1.5">Start Date</label>
            <input type="date" name="start_date" id="start_date"
                   class="w-full px-4 py-2.5 bg-slate-800 border border-slate-700 rounded-lg text-white text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent"
                   required>
            <p class="mt-1 text-xs text-slate-500">Course and enrolment start date.</p>
        </div>
        <div class="bg-slate-900 border border-slate-800 rounded-xl p-5">
            <label for="end_date" class="block text-sm font-medium text-slate-300 mb-1.5">End Date</label>
            <input type="date" name="end_date" id="end_date"
                   class="w-full px-4 py-2.5 bg-slate-800 border border-slate-700 rounded-lg text-white text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent"
                   required>
            <p class="mt-1 text-xs text-slate-500">Enrolment end date.</p>
        </div>
    </div>

    <!-- Preview Table -->
    <div class="animate-fade-in stagger-3">
        <div class="bg-slate-900 border border-slate-800 rounded-xl overflow-hidden">
            <div class="px-6 py-4 border-b border-slate-800">
                <h2 class="text-lg font-semibold text-white">Courses to Deploy</h2>
                <p class="text-sm text-slate-400 mt-0.5">Review the courses below before confirming deployment.</p>
            </div>
            <div class="overflow-x-auto">
                <table class="w-full">
                    <thead>
                        <tr class="text-left text-xs font-medium text-slate-400 uppercase tracking-wider">
                            <th class="px-6 py-3 border-b border-slate-800">#</th>
                            <th class="px-6 py-3 border-b border-slate-800">Nama Kelas</th>
                            <th class="px-6 py-3 border-b border-slate-800">Mata Kuliah</th>
                            <th class="px-6 py-3 border-b border-slate-800">Key Dosen</th>
                            <th class="px-6 py-3 border-b border-slate-800">Key Mahasiswa</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-800/50">
                        {{#each stagedCourses}}
                        <tr class="hover:bg-slate-800/30 transition-colors">
                            <td class="px-6 py-3 text-sm text-slate-500">{{sum @index 1}}</td>
                            <td class="px-6 py-3 text-sm font-medium text-white">{{this.final_course_name}}</td>
                            <td class="px-6 py-3 text-sm text-slate-300">{{this.mata_kuliah}}</td>
                            <td class="px-6 py-3 text-sm font-mono text-amber-300/80">{{this.enrolment_key_dosen}}</td>
                            <td class="px-6 py-3 text-sm font-mono text-cyan-300/80">{{this.enrolment_key_mhs}}</td>
                        </tr>
                        {{/each}}
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Actions -->
    <div class="mt-6 flex items-center gap-3 animate-fade-in stagger-4">
        <button type="submit"
                class="inline-flex items-center gap-2 px-6 py-3 rounded-lg bg-emerald-600 text-white font-medium text-sm hover:bg-emerald-500 transition-colors shadow-lg shadow-emerald-500/20 cursor-pointer"
                onclick="return confirm('Are you sure you want to deploy {{courseCount}} courses to Moodle? This action cannot be undone.')">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
            </svg>
            Confirm &amp; Deploy
        </button>
        <a href="/courses/{{category.id}}"
           class="px-6 py-3 rounded-lg text-sm font-medium text-slate-400 hover:text-white transition-colors">
            Cancel
        </a>
    </div>
</form>

<script>
document.addEventListener('DOMContentLoaded', () => {
    const startDateInput = document.getElementById('start_date');
    const endDateInput = document.getElementById('end_date');

    startDateInput.addEventListener('change', (e) => {
        if (!e.target.value) return;
        const startDate = new Date(e.target.value);
        // Add 10 years, subtract 6 months
        startDate.setFullYear(startDate.getFullYear() + 10);
        startDate.setMonth(startDate.getMonth() - 6);
        
        // Format to YYYY-MM-DD
        const year = startDate.getFullYear();
        const month = String(startDate.getMonth() + 1).padStart(2, '0');
        const day = String(startDate.getDate()).padStart(2, '0');
        
        endDateInput.value = `${year}-${month}-${day}`;
    });
});
</script>
