<!-- Breadcrumb -->
<nav class="mb-6 animate-fade-in">
    <ol class="flex items-center gap-2 text-sm text-slate-400">
        <li><a href="/courses" class="hover:text-white transition-colors">Dashboard</a></li>
        <li><svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg></li>
        <li><span class="text-slate-500">{{category.jurusan_name}}</span></li>
        <li><svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg></li>
        <li class="text-white font-medium">{{category.program_studi}}</li>
    </ol>
</nav>

<!-- Category Header -->
<div class="mb-8 animate-fade-in stagger-1">
    <div class="bg-slate-900 border border-slate-800 rounded-xl p-6">
        <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4">
            <div>
                <h1 class="text-2xl font-bold text-white">{{category.program_studi}}</h1>
                <p class="text-sm text-slate-400 mt-1">{{category.jurusan_name}}</p>
            </div>
            <div class="flex flex-wrap items-center gap-2">
                <!-- Edit Category IDs -->
                <button onclick="document.getElementById('editModal').classList.remove('hidden')"
                        class="px-3 py-2 text-sm font-medium rounded-lg bg-slate-800 text-slate-300 hover:bg-slate-700 hover:text-white border border-slate-700 transition-colors cursor-pointer">
                    <svg class="w-4 h-4 inline-block mr-1 -mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
                    </svg>
                    Edit IDs
                </button>
                <!-- Create Semester Category -->
                <form method="POST" action="/courses/{{category.id}}/create-semester" class="inline">
                    <button type="submit"
                            class="px-3 py-2 text-sm font-medium rounded-lg bg-emerald-500/10 text-emerald-400 hover:bg-emerald-500/20 border border-emerald-500/20 transition-colors cursor-pointer"
                            onclick="return confirm('Create a new semester sub-category in Moodle for the current academic period?')">
                        <svg class="w-4 h-4 inline-block mr-1 -mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6" />
                        </svg>
                        Create Semester Category
                    </button>
                </form>
            </div>
        </div>

        <!-- Moodle ID Info -->
        <div class="mt-4 flex flex-wrap gap-4">
            <div class="flex items-center gap-2 px-3 py-1.5 rounded-lg bg-slate-800/50 border border-slate-700/50">
                <span class="text-xs text-slate-500">Short Name:</span>
                {{#if category.short_name}}
                    <span class="text-sm font-mono text-indigo-300">{{category.short_name}}</span>
                {{else}}
                    <span class="text-sm text-amber-400/70 italic">Not set</span>
                {{/if}}
            </div>
            <div class="flex items-center gap-2 px-3 py-1.5 rounded-lg bg-slate-800/50 border border-slate-700/50">
                <span class="text-xs text-slate-500">Parent Cat ID:</span>
                <span class="text-sm font-mono text-slate-200">{{category.moodle_parent_cat_id}}</span>
            </div>
            <div class="flex items-center gap-2 px-3 py-1.5 rounded-lg bg-slate-800/50 border border-slate-700/50">
                <span class="text-xs text-slate-500">Semester Cat ID:</span>
                {{#if category.academic_year_cat_id}}
                    <span class="text-sm font-mono text-slate-200">{{category.academic_year_cat_id}}</span>
                {{else}}
                    <span class="text-sm text-amber-400/70 italic">Not set</span>
                {{/if}}
            </div>
            {{#if category.current_academic_year}}
            <div class="flex items-center gap-2 px-3 py-1.5 rounded-lg bg-slate-800/50 border border-slate-700/50">
                <span class="text-xs text-slate-500">Academic Year:</span>
                <span class="text-sm font-mono text-slate-200">{{category.current_academic_year}}</span>
            </div>
            {{/if}}
        </div>
    </div>
</div>

<!-- Action Buttons -->
<div class="flex flex-wrap items-center gap-3 mb-6 animate-fade-in stagger-2">
    <a href="/courses/{{category.id}}/add"
       class="inline-flex items-center gap-2 px-4 py-2.5 rounded-lg bg-indigo-600 text-white font-medium text-sm hover:bg-indigo-500 transition-colors shadow-lg shadow-indigo-500/20">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6" />
        </svg>
        Add Courses
    </a>
    {{#if hasStagedCourses}}
    <button id="deployBtn"
       class="inline-flex items-center gap-2 px-4 py-2.5 rounded-lg bg-emerald-600 text-white font-medium text-sm hover:bg-emerald-500 transition-colors shadow-lg shadow-emerald-500/20 cursor-pointer">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12" />
        </svg>
        <span>Deploy All</span>
    </button>
    <form id="deleteBatchForm" method="POST" action="/courses/{{category.id}}/delete-batch" class="hidden">
        <input type="hidden" name="ids" id="deleteBatchIds">
        <button type="submit"
                class="inline-flex items-center gap-2 px-4 py-2.5 rounded-lg bg-red-500/10 text-red-400 font-medium text-sm hover:bg-red-500/20 border border-red-500/20 transition-colors cursor-pointer"
                onclick="return confirm('Delete selected courses?')">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" /></svg>
            Delete Selected
        </button>
    </form>
    <form method="POST" action="/courses/{{category.id}}/delete-all" class="inline">
        <button type="submit"
                class="inline-flex items-center gap-2 px-4 py-2.5 rounded-lg bg-red-500/10 text-red-400 font-medium text-sm hover:bg-red-500/20 border border-red-500/20 transition-colors cursor-pointer"
                onclick="return confirm('Are you sure you want to clear ALL courses from the staging area?')">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" /></svg>
            Clear All
        </button>
    </form>
    {{/if}}
    <a href="/courses/{{category.id}}/history"
       class="inline-flex items-center gap-2 px-4 py-2.5 rounded-lg bg-slate-800 text-slate-300 font-medium text-sm hover:bg-slate-700 hover:text-white border border-slate-700 transition-colors">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        History
    </a>
</div>

<!-- Staged Courses Table -->
<div class="animate-fade-in stagger-3">
    <div class="bg-slate-900 border border-slate-800 rounded-xl overflow-hidden">
        <div class="px-6 py-4 border-b border-slate-800">
            <h2 class="text-lg font-semibold text-white">Staged Courses</h2>
            <p class="text-sm text-slate-400 mt-0.5">
                {{#if hasStagedCourses}}
                    {{stagedCourses.length}} course(s) ready for deployment
                {{else}}
                    No courses staged. Click "Add Courses" to get started.
                {{/if}}
            </p>
        </div>

        {{#if hasStagedCourses}}
        <div class="overflow-x-auto">
            <table class="w-full">
                <thead>
                    <tr class="text-left text-xs font-medium text-slate-400 uppercase tracking-wider">
                        <th class="px-6 py-3 border-b border-slate-800 w-12">
                            <input type="checkbox" id="selectAll" class="rounded border-slate-700 bg-slate-800 text-indigo-500 focus:ring-indigo-500">
                        </th>
                        <th class="px-6 py-3 border-b border-slate-800">#</th>
                        <th class="px-6 py-3 border-b border-slate-800">Nama Kelas</th>
                        <th class="px-6 py-3 border-b border-slate-800">Mata Kuliah</th>
                        <th class="px-6 py-3 border-b border-slate-800">RPS</th>
                        <th class="px-6 py-3 border-b border-slate-800">Key Dosen</th>
                        <th class="px-6 py-3 border-b border-slate-800">Key Mahasiswa</th>
                        <th class="px-6 py-3 border-b border-slate-800 text-right">Actions</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-800/50">
                    {{#each stagedCourses}}
                    <tr class="hover:bg-slate-800/30 transition-colors">
                        <td class="px-6 py-3">
                            <input type="checkbox" value="{{this.id}}" class="course-cb rounded border-slate-700 bg-slate-800 text-indigo-500 focus:ring-indigo-500">
                        </td>
                        <td class="px-6 py-3 text-sm text-slate-500">{{sum @index 1}}</td>
                        <td class="px-6 py-3 text-sm font-medium text-white">{{this.nama_kelas}}</td>
                        <td class="px-6 py-3 text-sm text-slate-300">{{this.mata_kuliah}}</td>
                        <td class="px-6 py-3 text-sm">
                            {{#if this.rps_file_path}}
                                <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded text-xs bg-indigo-500/10 text-indigo-300 border border-indigo-500/20" title="RPS file attached">
                                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                                    </svg>
                                    Attached
                                </span>
                            {{else}}
                                <span class="text-xs text-slate-600">—</span>
                            {{/if}}
                        </td>
                        <td class="px-6 py-3 text-sm font-mono text-amber-300/80">{{this.enrolment_key_dosen}}</td>
                        <td class="px-6 py-3 text-sm font-mono text-cyan-300/80">{{this.enrolment_key_mhs}}</td>

                        <td class="px-6 py-3 text-right">
                            <form method="POST" action="/courses/{{../category.id}}/delete/{{this.id}}" class="inline">
                                <button type="submit"
                                        class="text-red-400/60 hover:text-red-400 transition-colors cursor-pointer"
                                        onclick="return confirm('Delete this staged course?')"
                                        title="Delete">
                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                                    </svg>
                                </button>
                            </form>
                        </td>
                    </tr>
                    {{/each}}
                </tbody>
            </table>
        </div>
        {{else}}
        <div class="px-6 py-12 text-center">
            <svg class="w-12 h-12 mx-auto text-slate-700 mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M20 13V6a2 2 0 00-2-2H6a2 2 0 00-2 2v7m16 0v5a2 2 0 01-2 2H6a2 2 0 01-2-2v-5m16 0h-2.586a1 1 0 00-.707.293l-2.414 2.414a1 1 0 01-.707.293h-3.172a1 1 0 01-.707-.293l-2.414-2.414A1 1 0 006.586 13H4" />
            </svg>
            <p class="text-slate-500">Staging area is empty</p>
        </div>
        {{/if}}
    </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', () => {
    const selectAll = document.getElementById('selectAll');
    const checkboxes = document.querySelectorAll('.course-cb');
    const deleteBatchForm = document.getElementById('deleteBatchForm');
    const deleteBatchIds = document.getElementById('deleteBatchIds');
    const deployBtn = document.getElementById('deployBtn');

    function updateActionButtons() {
        const checked = Array.from(checkboxes).filter(cb => cb.checked);
        
        if (checked.length > 0) {
            deleteBatchForm.classList.remove('hidden');
            deleteBatchForm.classList.add('inline');
            deployBtn.querySelector('span').innerText = `Deploy Selected (${checked.length})`;
            deleteBatchIds.value = checked.map(cb => cb.value).join(',');
        } else {
            deleteBatchForm.classList.add('hidden');
            deleteBatchForm.classList.remove('inline');
            deployBtn.querySelector('span').innerText = 'Deploy All';
            deleteBatchIds.value = '';
        }
    }

    if (selectAll) {
        selectAll.addEventListener('change', (e) => {
            checkboxes.forEach(cb => cb.checked = e.target.checked);
            updateActionButtons();
        });
    }

    checkboxes.forEach(cb => {
        cb.addEventListener('change', () => {
            updateActionButtons();
            if (selectAll) {
                selectAll.checked = Array.from(checkboxes).every(c => c.checked);
            }
        });
    });

    if (deployBtn) {
        deployBtn.addEventListener('click', () => {
            const checked = Array.from(checkboxes).filter(cb => cb.checked).map(cb => cb.value);
            let url = '/courses/{{category.id}}/deploy';
            if (checked.length > 0) {
                url += '?ids=' + checked.join(',');
            }
            window.location.href = url;
        });
    }
});
</script>

<!-- Recent Deployments Preview -->
{{#if recentDeployments.length}}
<div class="mt-8 animate-fade-in stagger-4">
    <div class="bg-slate-900 border border-slate-800 rounded-xl overflow-hidden">
        <div class="px-6 py-4 border-b border-slate-800 flex items-center justify-between">
            <div>
                <h2 class="text-lg font-semibold text-white">Recent Deployments</h2>
                <p class="text-sm text-slate-400 mt-0.5">Latest deployment activity</p>
            </div>
            <a href="/courses/{{category.id}}/history" class="text-sm text-indigo-400 hover:text-indigo-300 transition-colors">
                View all →
            </a>
        </div>
        <div class="divide-y divide-slate-800/50">
            {{#each recentDeployments}}
            <a href="/courses/{{../category.id}}/history/{{this.id}}"
               class="flex items-center justify-between px-6 py-3 hover:bg-slate-800/30 transition-colors">
                <div class="flex items-center gap-3">
                    <div class="w-8 h-8 rounded-lg {{#if this.failed_count}}bg-red-500/10 border-red-500/20{{else}}bg-emerald-500/10 border-emerald-500/20{{/if}} border flex items-center justify-center">
                        {{#if this.failed_count}}
                        <svg class="w-4 h-4 text-red-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5L13.732 4c-.77-.833-1.964-.833-2.732 0L4.082 16.5c-.77.833.192 2.5 1.732 2.5z" />
                        </svg>
                        {{else}}
                        <svg class="w-4 h-4 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                        </svg>
                        {{/if}}
                    </div>
                    <div>
                        <p class="text-sm text-slate-200">{{this.course_count}} courses deployed</p>
                        <p class="text-xs text-slate-500">{{this.created_at}} · {{this.start_date}} — {{this.end_date}}</p>
                    </div>
                </div>
                <div class="flex items-center gap-2">
                    <span class="text-xs px-2 py-0.5 rounded-full bg-emerald-400/10 text-emerald-400">{{this.success_count}} ok</span>
                    {{#if this.failed_count}}
                    <span class="text-xs px-2 py-0.5 rounded-full bg-red-400/10 text-red-400">{{this.failed_count}} failed</span>
                    {{/if}}
                </div>
            </a>
            {{/each}}
        </div>
    </div>
</div>
{{/if}}

<!-- Edit Category Modal -->
<div id="editModal" class="hidden fixed inset-0 z-50 flex items-center justify-center p-4" style="background: rgba(0,0,0,0.6); backdrop-filter: blur(4px);">
    <div class="bg-slate-900 border border-slate-700 rounded-xl shadow-2xl w-full max-w-md">
        <form method="POST" action="/courses/{{category.id}}/edit">
            <div class="px-6 py-4 border-b border-slate-800">
                <h3 class="text-lg font-semibold text-white">Edit Moodle Category IDs</h3>
                <p class="text-sm text-slate-400 mt-1">Update the Moodle category IDs for this program studi.</p>
            </div>
            <div class="px-6 py-4 space-y-4">
                <div>
                    <label class="block text-sm font-medium text-slate-300 mb-1">Category Short Name</label>
                    <input type="text" name="short_name" value="{{category.short_name}}"
                           class="w-full px-3 py-2 bg-slate-800 border border-slate-700 rounded-lg text-white text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent"
                           placeholder="e.g., AB">
                </div>
                <div>
                    <label class="block text-sm font-medium text-slate-300 mb-1">Current Academic Year</label>
                    <input type="text" name="current_academic_year" value="{{category.current_academic_year}}"
                           class="w-full px-3 py-2 bg-slate-800 border border-slate-700 rounded-lg text-white text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent"
                           placeholder="e.g., 2023/2024">
                </div>
                <div>
                    <label class="block text-sm font-medium text-slate-300 mb-1">Parent Category ID</label>
                    <input type="number" name="moodle_parent_cat_id" value="{{category.moodle_parent_cat_id}}"
                           class="w-full px-3 py-2 bg-slate-800 border border-slate-700 rounded-lg text-white text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent" required>
                </div>
                <div>
                    <label class="block text-sm font-medium text-slate-300 mb-1">Semester Category ID</label>
                    <input type="number" name="academic_year_cat_id" value="{{category.academic_year_cat_id}}"
                           class="w-full px-3 py-2 bg-slate-800 border border-slate-700 rounded-lg text-white text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent"
                           placeholder="Leave empty if not set">
                </div>
            </div>
            <div class="px-6 py-4 border-t border-slate-800 flex items-center justify-end gap-3">
                <button type="button" onclick="document.getElementById('editModal').classList.add('hidden')"
                        class="px-4 py-2 text-sm font-medium text-slate-400 hover:text-white transition-colors cursor-pointer">
                    Cancel
                </button>
                <button type="submit"
                        class="px-4 py-2 text-sm font-medium bg-indigo-600 text-white rounded-lg hover:bg-indigo-500 transition-colors cursor-pointer">
                    Save Changes
                </button>
            </div>
        </form>
    </div>
</div>
