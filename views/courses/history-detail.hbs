<!-- Breadcrumb -->
<nav class="mb-6 animate-fade-in">
    <ol class="flex items-center gap-2 text-sm text-slate-400">
        <li><a href="/courses" class="hover:text-white transition-colors">Dashboard</a></li>
        <li><svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg></li>
        <li><a href="/courses/{{category.id}}" class="hover:text-white transition-colors">{{category.program_studi}}</a></li>
        <li><svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg></li>
        <li><a href="/courses/{{category.id}}/history" class="hover:text-white transition-colors">History</a></li>
        <li><svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg></li>
        <li class="text-white font-medium">Deployment #{{deployment.id}}</li>
    </ol>
</nav>

<!-- Summary -->
<div class="mb-8 animate-fade-in">
    <div class="bg-slate-900 border border-slate-800 rounded-xl p-6">
        <div class="flex items-start gap-4">
            {{#if failedCount}}
            <div class="w-12 h-12 rounded-xl bg-amber-500/10 border border-amber-500/20 flex items-center justify-center flex-shrink-0">
                <svg class="w-6 h-6 text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5L13.732 4c-.77-.833-1.964-.833-2.732 0L4.082 16.5c-.77.833.192 2.5 1.732 2.5z" />
                </svg>
            </div>
            {{else}}
            <div class="w-12 h-12 rounded-xl bg-emerald-500/10 border border-emerald-500/20 flex items-center justify-center flex-shrink-0">
                <svg class="w-6 h-6 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
            </div>
            {{/if}}
            <div>
                <div class="flex items-center gap-3">
                    <h1 class="text-2xl font-bold text-white">Deployment #{{deployment.id}}</h1>
                    {{#ifEquals deployment.status "processing"}}
                        <span class="px-2.5 py-0.5 rounded-full text-xs font-medium bg-blue-500/10 text-blue-400 border border-blue-500/20 animate-pulse">Processing</span>
                    {{/ifEquals}}
                    {{#ifEquals deployment.status "completed_with_errors"}}
                        <span class="px-2.5 py-0.5 rounded-full text-xs font-medium bg-amber-500/10 text-amber-400 border border-amber-500/20">Completed with errors</span>
                    {{/ifEquals}}
                </div>
                <p class="mt-1 text-slate-400">{{category.program_studi}}</p>
                
                {{#ifEquals deployment.status "processing"}}
                <div class="mt-4">
                    <div class="flex justify-between text-xs text-slate-400 mb-1.5">
                        <span>Deploying courses to Moodle...</span>
                        <span id="progressText">{{deployment.processed_courses}} / {{deployment.total_courses}} ({{progressPercent}}%)</span>
                    </div>
                    <div class="w-full bg-slate-800 rounded-full h-2">
                        <div id="progressBar" class="bg-indigo-500 h-2 rounded-full transition-all duration-300" style="width: {{progressPercent}}%"></div>
                    </div>
                </div>
                <script>
                    function pollStatus() {
                        setTimeout(async () => {
                            try {
                                const res = await fetch('/courses/{{category.id}}/history/{{deployment.id}}/status');
                                const data = await res.json();
                                if (data.status !== 'processing') {
                                    window.location.reload();
                                } else {
                                    let percent = Math.round((data.processed_courses / data.total_courses) * 100) || 0;
                                    document.getElementById('progressBar').style.width = percent + '%';
                                    document.getElementById('progressText').innerText = data.processed_courses + ' / ' + data.total_courses + ' (' + percent + '%)';
                                    pollStatus(); // poll again
                                }
                            } catch (e) {
                                pollStatus();
                            }
                        }, 2000);
                    }
                    pollStatus();
                </script>
                {{else}}
                <div class="mt-3 flex flex-wrap items-center gap-4 text-sm">
                    <div class="flex items-center gap-1.5 text-slate-400">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" /></svg>
                        {{deployment.created_at}}
                    </div>
                    <div class="text-slate-500">{{deployment.start_date}} → {{deployment.end_date}}</div>
                </div>
                <div class="mt-3 flex items-center gap-4">
                    <div class="flex items-center gap-1.5">
                        <div class="w-3 h-3 rounded-full bg-emerald-400"></div>
                        <span class="text-sm text-slate-300">{{successCount}} successful</span>
                    </div>
                    {{#if failedCount}}
                    <div class="flex items-center gap-1.5">
                        <div class="w-3 h-3 rounded-full bg-red-400"></div>
                        <span class="text-sm text-slate-300">{{failedCount}} failed</span>
                    </div>
                    {{/if}}
                    <span class="text-sm text-slate-500">{{totalCount}} total</span>
                </div>
                {{/ifEquals}}
            </div>
        </div>
    </div>
</div>

<!-- Courses Table -->
<div class="animate-fade-in stagger-1">
    <div class="bg-slate-900 border border-slate-800 rounded-xl overflow-hidden">
        <div class="px-6 py-4 border-b border-slate-800">
            <h2 class="text-lg font-semibold text-white">Deployed Courses</h2>
        </div>
        <div class="overflow-x-auto">
            <table class="w-full">
                <thead>
                    <tr class="text-left text-xs font-medium text-slate-400 uppercase tracking-wider">
                        <th class="px-6 py-3 border-b border-slate-800">#</th>
                        <th class="px-6 py-3 border-b border-slate-800">Nama Kelas</th>
                        <th class="px-6 py-3 border-b border-slate-800">Mata Kuliah</th>
                        <th class="px-6 py-3 border-b border-slate-800">Key Dosen</th>
                        <th class="px-6 py-3 border-b border-slate-800">Key Mahasiswa</th>
                        <th class="px-6 py-3 border-b border-slate-800">Status</th>
                        <th class="px-6 py-3 border-b border-slate-800">RPS Status</th>
                        <th class="px-6 py-3 border-b border-slate-800">Moodle</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-800/50">
                    {{#each courses}}
                    <tr class="hover:bg-slate-800/30 transition-colors">
                        <td class="px-6 py-3 text-sm text-slate-500">{{sum @index 1}}</td>
                        <td class="px-6 py-3 text-sm font-medium text-white">{{this.nama_kelas}}</td>
                        <td class="px-6 py-3 text-sm text-slate-300">{{this.mata_kuliah}}</td>
                        <td class="px-6 py-3 text-sm font-mono text-amber-300/80">{{this.enrolment_key_dosen}}</td>
                        <td class="px-6 py-3 text-sm font-mono text-cyan-300/80">{{this.enrolment_key_mhs}}</td>
                        <td class="px-6 py-3">
                            {{#ifEquals this.status "success"}}
                            <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-emerald-400/10 text-emerald-400 border border-emerald-400/20">
                                Success
                            </span>
                            {{else}}
                            <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-red-400/10 text-red-400 border border-red-400/20"
                                  title="{{this.error_message}}">
                                Failed
                            </span>
                            {{/ifEquals}}
                        </td>
                        <td class="px-6 py-3">
                            {{#ifEquals this.rps_status "success"}}
                            <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-xs font-medium bg-emerald-400/10 text-emerald-400 border border-emerald-400/20">
                                Uploaded
                            </span>
                            {{else}}
                                {{#ifEquals this.rps_status "failed"}}
                                <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-xs font-medium bg-red-400/10 text-red-400 border border-red-400/20"
                                      title="{{this.rps_error_message}}">
                                    Failed
                                </span>
                                {{else}}
                                <span class="text-slate-600">—</span>
                                {{/ifEquals}}
                            {{/ifEquals}}
                        </td>

                        <td class="px-6 py-3 text-sm">
                            {{#if this.moodle_course_id}}
                            <a href="{{MOODLE_BASE_URL}}/course/view.php?id={{this.moodle_course_id}}" target="_blank"
                               class="text-indigo-400 hover:text-indigo-300 transition-colors inline-flex items-center gap-1">
                                View
                                <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                                </svg>
                            </a>
                            {{else}}
                            <span class="text-slate-600">—</span>
                            {{/if}}
                        </td>
                    </tr>
                    {{/each}}
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Actions -->
<div class="mt-6 flex flex-wrap items-center gap-3 animate-fade-in stagger-2">
    <a href="/courses/{{category.id}}/history"
       class="inline-flex items-center gap-2 px-4 py-2 rounded-lg text-sm font-medium text-slate-300 hover:text-white bg-slate-800 border border-slate-700 transition-colors">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
        </svg>
        Back to History
    </a>
    
    <form method="POST" action="/courses/{{category.id}}/history/{{deployment.id}}/reuse" class="inline">
        <button type="submit"
                class="inline-flex items-center gap-2 px-4 py-2 rounded-lg text-sm font-medium text-indigo-300 hover:text-white hover:bg-indigo-600 bg-indigo-600/20 border border-indigo-500/30 transition-colors cursor-pointer"
                onclick="return confirm('Copy these {{totalCount}} courses back into the staging area (with their current enrolment keys)?')">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
            </svg>
            Stage Again
        </button>
    </form>
    
    <div class="ml-auto flex items-center gap-3">
        <a href="/courses/{{category.id}}/history/{{deployment.id}}/export/xlsx"
           class="inline-flex items-center gap-2 px-4 py-2 rounded-lg text-sm font-medium text-emerald-300 hover:text-white hover:bg-emerald-600 bg-emerald-600/20 border border-emerald-500/30 transition-colors">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
            </svg>
            Export Excel
        </a>
        <a href="/courses/{{category.id}}/history/{{deployment.id}}/export/pdf"
           class="inline-flex items-center gap-2 px-4 py-2 rounded-lg text-sm font-medium text-red-300 hover:text-white hover:bg-red-600 bg-red-600/20 border border-red-500/30 transition-colors">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
            </svg>
            Export PDF
        </a>
    </div>
</div>
