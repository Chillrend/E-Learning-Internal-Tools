<!-- Dashboard Header -->
<div class="mb-8 animate-fade-in">
    <h1 class="text-3xl font-bold text-white">Course Management</h1>
    <p class="mt-2 text-slate-400">Select a program studi to manage courses and deployments.</p>
</div>

<!-- Jurusan Accordion Sections -->
{{#each jurusanList}}
<div class="mb-4 animate-fade-in" style="animation-delay: {{multiply @index 0.05}}s">
    <div class="bg-slate-900 border border-slate-800 rounded-xl overflow-hidden">
        <!-- Jurusan Header (clickable) -->
        <button onclick="toggleAccordion(this)" class="w-full flex items-center justify-between px-6 py-4 text-left hover:bg-slate-800/50 transition-colors group">
            <div class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-lg bg-indigo-500/10 border border-indigo-500/20 flex items-center justify-center group-hover:bg-indigo-500/20 transition-colors">
                    <svg class="w-5 h-5 text-indigo-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
                    </svg>
                </div>
                <div>
                    <h2 class="text-lg font-semibold text-white">{{this.name}}</h2>
                    <p class="text-sm text-slate-400">{{this.prodi_count}} Program Studi
                        {{#if this.staged_count}}
                            <span class="ml-2 inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-amber-400/10 text-amber-400 border border-amber-400/20">
                                {{this.staged_count}} staged
                            </span>
                        {{/if}}
                    </p>
                </div>
            </div>
            <svg class="w-5 h-5 text-slate-500 transition-transform accordion-arrow" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
            </svg>
        </button>

        <!-- Prodi List (collapsed by default) -->
        <div class="accordion-content">
            <div class="border-t border-slate-800">
                {{#each this.categories}}
                <a href="/courses/{{this.id}}"
                   class="flex items-center justify-between px-6 py-3 hover:bg-slate-800/30 transition-colors border-b border-slate-800/50 last:border-b-0 group">
                    <div class="flex items-center gap-3">
                        <div class="w-2 h-2 rounded-full {{#if this.academic_year_cat_id}}bg-emerald-400{{else}}bg-slate-600{{/if}}"></div>
                        <div>
                            <span class="text-sm font-medium text-slate-200 group-hover:text-white transition-colors">{{this.program_studi}}</span>
                            <div class="flex items-center gap-3 mt-0.5">
                                <span class="text-xs text-slate-500">Parent: {{this.moodle_parent_cat_id}}</span>
                                {{#if this.academic_year_cat_id}}
                                    <span class="text-xs text-slate-500">Semester: {{this.academic_year_cat_id}}</span>
                                {{else}}
                                    <span class="text-xs text-amber-500/70">No semester category</span>
                                {{/if}}
                            </div>
                        </div>
                    </div>
                    <div class="flex items-center gap-2">
                        {{#if this.staged_count}}
                            <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-amber-400/10 text-amber-400 border border-amber-400/20">
                                {{this.staged_count}} staged
                            </span>
                        {{/if}}
                        <svg class="w-4 h-4 text-slate-600 group-hover:text-slate-400 transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                        </svg>
                    </div>
                </a>
                {{/each}}
            </div>
        </div>
    </div>
</div>
{{/each}}

<script>
function toggleAccordion(button) {
    const content = button.nextElementSibling;
    const arrow = button.querySelector('.accordion-arrow');
    content.classList.toggle('open');
    arrow.classList.toggle('rotate-180');
}

// Helper for Handlebars — animation stagger
// (Handlebars doesn't support multiply, so we use inline styles set by the server or just CSS)
</script>
