<div class="min-h-[40vh] flex items-center justify-center">
    <div class="text-center animate-fade-in">
        <h1 class="text-6xl font-bold text-slate-700 mb-4">{{message}}</h1>
        <p class="text-slate-400 mb-6">{{#if error.status}}Error {{error.status}}{{/if}}</p>
        {{#if error.stack}}
        <pre class="text-left mt-6 p-4 bg-slate-900 border border-slate-800 rounded-xl text-sm text-red-400/80 overflow-x-auto max-w-2xl mx-auto">{{error.stack}}</pre>
        {{/if}}
        <a href="/courses" class="inline-block mt-6 text-indigo-400 hover:text-indigo-300 text-sm transition-colors">← Back to Dashboard</a>
    </div>
</div>
