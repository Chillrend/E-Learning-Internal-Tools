<!-- Breadcrumb -->
<nav class="mb-6">
    <ol class="flex items-center gap-2 text-sm text-slate-400">
        <li><a href="/courses" class="hover:text-white transition-colors">Dashboard</a></li>
        <li><svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg></li>
        <li><a href="/export" class="hover:text-white transition-colors">Export</a></li>
        <li><svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg></li>
        <li class="text-white font-medium">Deployment Results</li>
    </ol>
</nav>

<div class="mb-6">
    <h1 class="text-2xl font-bold text-white mb-2">Deployment Results</h1>
    <div class="space-y-1 text-sm text-slate-400">
        <p>Category: <span class="text-white">{{category}}</span></p>
        <p>Enrolment Start Date: <span class="text-white">{{enrolmentStartDate}}</span></p>
        <p>Enrolment End Date: <span class="text-white">{{enrolmentEndDate}}</span></p>
    </div>
    <p class="mt-2 text-sm text-slate-500">Failed columns are marked with <span class="text-red-400 font-medium">FAIL!</span></p>
</div>

<div class="bg-slate-900 border border-slate-800 rounded-xl overflow-hidden">
    <div class="overflow-x-auto">
        <table class="w-full">
            <thead>
                <tr class="text-left text-xs font-medium text-slate-400 uppercase tracking-wider">
                    <th class="px-6 py-3 border-b border-slate-800">No.</th>
                    <th class="px-6 py-3 border-b border-slate-800">Course Name</th>
                    <th class="px-6 py-3 border-b border-slate-800">Key Dosen</th>
                    <th class="px-6 py-3 border-b border-slate-800">Key Mahasiswa</th>
                    <th class="px-6 py-3 border-b border-slate-800">Create Course</th>
                    <th class="px-6 py-3 border-b border-slate-800">Create Dosen Key</th>
                    <th class="px-6 py-3 border-b border-slate-800">Create MHS Key</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-slate-800/50">
                {{#each rows}}
                <tr class="hover:bg-slate-800/30 transition-colors">
                    <td class="px-6 py-3 text-sm text-slate-500">{{@index}}</td>
                    <td class="px-6 py-3 text-sm font-medium text-white">{{{this.[3]}}}</td>
                    <td class="px-6 py-3 text-sm font-mono text-amber-300/80">{{this.[4]}}</td>
                    <td class="px-6 py-3 text-sm font-mono text-cyan-300/80">{{this.[5]}}</td>
                    <td class="px-6 py-3 text-sm">{{{this.[6]}}}</td>
                    <td class="px-6 py-3 text-sm">{{{this.[7]}}}</td>
                    <td class="px-6 py-3 text-sm">{{{this.[8]}}}</td>
                </tr>
                {{/each}}
            </tbody>
        </table>
    </div>
</div>